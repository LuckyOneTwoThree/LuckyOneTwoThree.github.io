---
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../data/about';

const works = [
  { title: 'Reckoner', href: '/work/reckoner', note: '决策内核 / 假设台账' },
  { title: '夜猫看台', href: '/work/nightowl', note: '观赛决策工作台' },
  { title: 'harness-all', href: '/work/harness-all', note: 'AI 研发治理层' },
  { title: 'vibe-skill', href: '/work/vibe-skill', note: '127 个 Skill 的方法论体系' },
];
---

<BaseLayout title="人物" description="LuckyOneTwoThree：全栈产品、重度玩家、写作者。一个产品人的使用说明。">
  <section class="about-hero wrap">
    <p class="kicker">Player card / 05</p>
    <h1 class="page-title">一个产品人的<br />使用说明。</h1>
    <p class="dek">我在意什么、我的偏见、怎么和我合作，以及我目前还没修好的地方。坐标：{about.city}。</p>
  </section>

  <section class="section wrap">
    <div class="about-grid">
      <div class="player-card">
        <div class="player-card-top">
          <span class="mono">{about.name}</span>
          <span class="mono">NO. 001 / 2026</span>
        </div>
        <div class="player-card-main">
          <div>
            <p class="mono" style="margin:0; color:var(--muted);">位置 / POSITION</p>
            <h3>{about.position}</h3>
            <p class="player-dek">系统化思考，快速原型，叙事驱动。喜欢把复杂问题拆成可以今晚动手的小实验。</p>
          </div>
          <div class="player-number" aria-hidden="true">01</div>
        </div>
        <div class="player-stats">
          <div>
            <span class="mono">强项 / STRENGTHS</span>
            <p>{about.strengths.map((item, i) => <span>{item.text}{i < about.strengths.length - 1 && <br />}</span>)}</p>
          </div>
          <div>
            <span class="mono">伤病史 / KNOWN ISSUES</span>
            <p>{about.issues.map((item, i) => <span>{item}{i < about.issues.length - 1 && <br />}</span>)}</p>
          </div>
        </div>
        <div class="player-foot">
          <a class="mono" href="/now">GEAR → /NOW</a>
          <a class="mono" href="#work-mode">WORK MODE →</a>
        </div>
      </div>
      <div class="about-side">
        <p class="about-quote">“意义不是被发现的，是被走出来的。”</p>
        <div class="about-list">
          <div>
            <span class="mono">社区 / CHANNELS</span>
            <div class="channel-list">
              {about.channels.map((channel) => (
                <a href={channel.href} target="_blank" rel="noreferrer">{channel.label}</a>
              ))}
            </div>
          </div>
          <div>
            <span class="mono">在练 / TRAINING</span>
            <p>乒乓球 · 羽毛球 · 足球</p>
          </div>
          <div>
            <span class="mono">使用说明 / HOW TO WORK WITH ME</span>
            <p>给我问题，不要给我“感觉”；给我取舍，不要给我“都要”。</p>
          </div>
        </div>
        <a class="text-link" href="/now">看此刻 <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div><p class="kicker">Principles</p><h2>我在意什么</h2></div>
      <span class="mono">不是标语，是裁决规则</span>
    </div>
    <ol class="principle-list">
      {about.principles.map((principle, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span>{principle}</li>
      ))}
    </ol>
  </section>

  <section class="section wrap" id="work-mode">
    <div class="section-head">
      <div><p class="kicker">Work mode</p><h2>工作版</h2></div>
      <span class="mono">给招聘 / 合作方</span>
    </div>
    <div class="work-list">
      {works.map((work, index) => (
        <a class="work-row" href={work.href}>
          <span class="work-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="work-main"><strong>{work.title}</strong><em>{work.note}</em></span>
          <span class="work-tags">案例</span>
          <span class="work-status"><i class="dot"></i>可读</span>
          <span class="work-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="prose" style="margin-top: 34px;">
      <p>我的工作方式：先把问题定义清楚，再做最小的可验证实验；如果方向错了，尽快承认并改。产品、设计、前端、AI 工作流是我常用的四块能力，项目页里有具体取舍和证据。</p>
      <p>合作/招聘：通过 GitHub 或知乎私信找我。请直接说问题、约束和你想要的取舍，不需要先写一份漂亮的 brief。</p>
    </div>
  </section>
</BaseLayout>
