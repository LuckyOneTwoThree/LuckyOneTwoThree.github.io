---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hands } from '../data/hand';
import { now } from '../data/now';
import { tierItems } from '../data/tier';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const notes = await getCollection('notes');
const greenhouse = notes.find((note) => note.id === 'greenhouse');
const corrections = notes.find((note) => note.id === 'corrections');
const shortNote = notes.find((note) => note.id === 'tool-not-coworker');
const featuredWork = work.slice(0, 4);
const culture = tierItems.filter((item) => item.featured).slice(0, 3);
const hand = hands[0];
---

<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span>全栈产品</span><span>夜行动物</span><span>持续建造</span></p>
      <h1>
        <span class="line">白天做产品，</span>
        <span class="line">晚上研究什么值得<em>熬夜</em>。</span>
      </h1>
      <p class="hero-dek">一个产品人的 A/B 面。这里记录我做出来的东西、想明白的事，以及愿意为之熬夜的比赛、游戏、番和电影。</p>
      <div class="hero-actions">
        <a class="btn" href="#hand">逛一手 <span>↘</span></a>
        <a class="text-link" href="/work">看出品 <span>→</span></a>
      </div>
      <p class="hero-note">A 面让人信任你，B 面让人喜欢你。<br />但它们是同一张唱片。</p>
    </div>
    <div class="hero-record" data-record role="button" tabindex="0" aria-label="点一下，停一停唱片">
      <div class="record">
        <div class="record-label">
          <span>B</span>
          <small>SIDE B</small>
          <small>33⅓</small>
        </div>
      </div>
      <div class="record-caption">
        <span>NO. 001</span>
        <span>2026.10.29</span>
        <span>城市 · 夜</span>
      </div>
    </div>
  </section>

  <section class="now-bar" aria-label="此刻">
    <div class="wrap now-grid">
      <span class="now-label">此刻 / NOW</span>
      <div class="now-item"><small>在做</small><p>{now.doing}</p></div>
      <div class="now-item"><small>在看</small><p>幻视任务 <span>/ 黑色五叶草 S2</span></p></div>
      <div class="now-item"><small>在玩</small><p>影之刃零 <span>/ 星铁</span></p></div>
      <div class="now-item"><small>在听</small><p>Risk It All <span>Bruno Mars</span></p></div>
      <div class="now-updated">最后更新<br /><strong>{now.updated}</strong></div>
    </div>
  </section>

  <section class="section wrap" id="hand">
    <div class="section-head">
      <div>
        <p class="kicker">01 / Tonight's hand</p>
        <h2>今日手牌</h2>
      </div>
      <div class="hand-tools">
        <div class="time-filter" role="group" aria-label="按今晚可用时间筛选">
          <button class="chip is-active" type="button" data-hand="0" aria-pressed="true">20 分钟</button>
          <button class="chip" type="button" data-hand="1" aria-pressed="false">2 小时</button>
          <button class="chip" type="button" data-hand="2" aria-pressed="false">通宵</button>
        </div>
        <button class="shuffle" id="shuffleHand" type="button">换一手 <span>↻</span></button>
      </div>
    </div>
    <div class="hand-grid" id="handGrid" aria-live="polite">
      {hand.map((card) => (
        <a class:list={['hand-card', { lead: card.lead }]} href={card.href}>
          <div class="card-top"><span class="card-num">{String(hand.indexOf(card) + 1).padStart(2, '0')}</span><span>{card.kicker}</span></div>
          <h3>{card.title}</h3>
          <p>{card.desc}</p>
          <div class="card-foot"><span>{card.meta}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
        </a>
      ))}
    </div>
    <div class="section-foot">
      <a class="text-link" href="/work">全部内容 <span>→</span></a>
      <span class="mono">一手三张，我替你选。</span>
    </div>
  </section>

  <section class="section wrap" id="work">
    <div class="section-head">
      <div>
        <p class="kicker">02 / Selected work</p>
        <h2>最新出品</h2>
      </div>
      <a class="text-link" href="/work">全部出品 <span>→</span></a>
    </div>
    <div class="work-list">
      {featuredWork.map((entry, index) => (
        <a class="work-row" href={`/work/${entry.id}`}>
          <span class="work-index">{String(index + 1).padStart(2, '0')}</span>
          <span class="work-main"><strong>{entry.data.title}</strong><em>{entry.data.oneLiner}</em></span>
          <span class="work-tags">{entry.data.themes.join(' / ')}<br />{entry.data.stack.slice(0, 2).join(' / ')}</span>
          <span class="work-status"><i class:list={['dot', { paused: entry.data.status.includes('暂停') }]}></i>{entry.data.status}</span>
          <span class="work-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="section-foot">
      <span class="mono">状态以最后提交为准 · 最后核对 2026.10.29</span>
      <span class="mono">运行中 1 · 已发布暂停 3</span>
    </div>
  </section>

  <section class="section wrap" id="notes">
    <div class="section-head">
      <div>
        <p class="kicker">03 / Notes</p>
        <h2>最新夜记</h2>
      </div>
      <a class="text-link" href="/notes">全部夜记 <span>→</span></a>
    </div>
    <div class="notes-list">
      {greenhouse && (
        <a class="note-row" href="/notes/greenhouse">
          <span class="note-index">01</span>
          <span><h2>{greenhouse.data.title}</h2><p class="note-dek">{greenhouse.data.dek}</p></span>
          <span class="note-meta">{greenhouse.data.date} · {greenhouse.data.readingTime} 分钟<br />{greenhouse.data.series}</span>
          <span class="note-arrow" aria-hidden="true">↗</span>
        </a>
      )}
      {corrections && (
        <a class="note-row" href="/notes/corrections">
          <span class="note-index">02</span>
          <span><h2>{corrections.data.title}</h2><p class="note-dek">{corrections.data.dek}</p></span>
          <span class="note-meta">{corrections.data.date} · {corrections.data.readingTime} 分钟<br />{corrections.data.series}</span>
          <span class="note-arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
    {shortNote && (
      <div class="short-notes">
        <a class="short-note" href={`/notes/${shortNote.id}`}>
          <span class="mono">短记 / {shortNote.data.series}</span>
          <h3>{shortNote.data.title}</h3>
          <p>{shortNote.data.dek}</p>
        </a>
        <a class="short-note" href="/notes">
          <span class="mono">更多短记</span>
          <h3>原则、判断、更正</h3>
          <p>一些来不及写成长文的句子，先放在这里。</p>
        </a>
      </div>
    )}
  </section>

  <section class="section wrap" id="culture">
    <div class="section-head">
      <div>
        <p class="kicker">04 / The tier list</p>
        <h2>夯到拉</h2>
      </div>
      <a class="text-link" href="/culture">全部榜单 <span>→</span></a>
    </div>
    <p class="tier-intro">不是客观评分，是我的口味。每个 placement 都有一句 why。<span class="mono">占位初排 · 待你改</span></p>
    <div class="tier-list">
      {culture.map((item) => (
        <a class="tier-row" href={`/culture#${item.slug}`}>
          <span class="tier-letter">{item.tier}</span>
          <span class="tier-title">{item.title}</span>
          <span class="tier-verdict">{item.verdict}</span>
          <span class="tier-time">适合：{item.duration}</span>
          <span class="tier-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <div class="tier-foot">
      <span>本周看台：英超 / 欧冠</span>
      <span>评分标准：愿意为它花掉哪个夜晚。</span>
    </div>
  </section>

  <section class="bside-section" id="bside">
    <div class="wrap bside-inner">
      <div class="section-head">
        <div>
          <p class="kicker">05 / B-side</p>
          <h2>每篇内容，都有 B 面</h2>
        </div>
        <a class="text-link" href="/notes/greenhouse?side=b">看一篇 B 面 <span>→</span></a>
      </div>
      <div class="bside-grid">
        <div class="bside-copy">
          <p class="kicker">夜记 / 温室里没有风</p>
          <h3>这篇稿子起于 10 月 19 日，改到 20 日，然后停在“平台待定”。</h3>
          <p class="meta">不是没写完，是没发出去。</p>
          <p class="meta">B 面不是花絮，是判断的另一半。</p>
        </div>
        <aside class="bside-margin">
          <div class="stamp" aria-hidden="true">B</div>
          <p>A 面让人信任你，<br />B 面让人喜欢你。</p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ hands }}>
  const handGrid = document.getElementById('handGrid');
  let currentHand = 0;

  function renderHand(index) {
    if (!handGrid) return;
    handGrid.innerHTML = hands[index].map((card, i) => `
      <a class="hand-card${card.lead ? ' lead' : ''}" href="${card.href}">
        <div class="card-top"><span class="card-num">${String(i + 1).padStart(2, '0')}</span><span>${card.kicker}</span></div>
        <h3>${card.title}</h3>
        <p>${card.desc}</p>
        <div class="card-foot"><span>${card.meta}</span><span class="card-arrow" aria-hidden="true">↗</span></div>
      </a>
    `).join('');
  }

  document.querySelectorAll('.chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      currentHand = Number(chip.dataset.hand);
      document.querySelectorAll('.chip').forEach((c) => {
        const active = c === chip;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', String(active));
      });
      renderHand(currentHand);
    });
  });

  document.getElementById('shuffleHand')?.addEventListener('click', () => {
    currentHand = (currentHand + 1) % hands.length;
    document.querySelectorAll('.chip').forEach((c) => {
      const active = Number(c.dataset.hand) === currentHand;
      c.classList.toggle('is-active', active);
      c.setAttribute('aria-pressed', String(active));
    });
    renderHand(currentHand);
  });
  const record = document.querySelector('[data-record]');
  const toggleRecord = () => record?.classList.toggle('is-paused');
  record?.addEventListener('click', toggleRecord);
  record?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault();
      toggleRecord();
    }
  });
</script>
